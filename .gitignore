# Shared monorepo tooling — read-only bind mount into the worker/cron
# container ($HOME/projects/domains/tools -> .monorepo-tools), NOT part of
# this repo. Without this line, a container-side git operation can
# accidentally sweep the entire shared tools/ tree into this repo (hit
# 0daynews.com 2026-07-13, 472 files). Never remove this line.
.monorepo-tools/

ops/logs/*.log
ops/logs/token-usage-*.jsonl
ops/.locks/
ops/logs/engineer-issues-*.txt
ops/logs/engineer-render-fail-*.png
ops/logs/engineer-render-last.json
ops/facts.yaml
ops/board/last-run.json

# Engineer liveness pulse log (machine-readable, monitoring)
ops/logs/engineer-heartbeat-*.jsonl

# Watchdog incident ledger + kill switch (machine state, not source)
ops/health/
ops/.watchdog-disabled

